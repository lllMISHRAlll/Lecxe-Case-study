# Copy to .env and fill in. Never commit .env.

# Company database (Railway). SSL is required.
DATABASE_URL=postgresql://user:password@host:port/railway
DATABASE_SSLMODE=require

# OpenAI. Without a key the app runs with an offline rule-based stand-in (FAKE_LLM).
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini        # guardrails, routing, follow-ups, PO extraction
OPENAI_MODEL_SQL=gpt-4o              # schema linking, SQL, answers
FAKE_LLM=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
DEMO_LOGIN_PASSWORD=1234567890       # shown on the quick-login buttons outside prod
APP_ENV=dev                          # dev | test | prod (prod hides the demo password)

# Business rules
FX_USD_INR=88

# Limits
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300

# LangSmith (tracing turns on only when both are set)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=procurement-assistant
LANGSMITH_ENDPOINT=                  # optional, e.g. https://eu.api.smith.langchain.com

# Local test database (docker compose service "testdb")
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/postgres
